{
  "name": "infinite-grimoire",
  "version": "0.1.0",
  "description": "Minimalist pixel idle alchemy web game: auto-battling mage, element synthesis, server-validated progress.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ronaldzzzzz/InfiniteGrimoire.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bugs": {
    "url": "https://github.com/Ronaldzzzzz/InfiniteGrimoire/issues"
  },
  "homepage": "https://github.com/Ronaldzzzzz/InfiniteGrimoire#readme",
  "dependencies": {
    "hono": "^4.13.13",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "private": true
}
